{
  "manifest_version": 3,
  "name": "VeilGuard AI",
  "version": "0.0.1",
  "description": "Context-aware privacy firewall for AI tools.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:4310/*",
    "http://localhost:4310/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://*.gemini.google.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.copilot.microsoft.com/*",
    "https://poe.com/*",
    "https://*.poe.com/*",
    "https://mistral.ai/*",
    "https://*.mistral.ai/*",
    "https://aistudio.google.com/*",
    "https://*.aistudio.google.com/*",
    "https://huggingface.co/chat/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:4310/*",
        "http://localhost:4310/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://*.gemini.google.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://*.poe.com/*",
        "https://mistral.ai/*",
        "https://*.mistral.ai/*",
        "https://aistudio.google.com/*",
        "https://*.aistudio.google.com/*",
        "https://huggingface.co/chat/*"
      ],
      "js": [
        "page-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://127.0.0.1:4310/*",
        "http://localhost:4310/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://*.gemini.google.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://*.poe.com/*",
        "https://mistral.ai/*",
        "https://*.mistral.ai/*",
        "https://aistudio.google.com/*",
        "https://*.aistudio.google.com/*",
        "https://huggingface.co/chat/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VeilGuard AI"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
