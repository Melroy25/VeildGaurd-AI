{
  "manifest_version": 3,
  "name": "VeilGuard AI",
  "version": "0.0.1",
  "description": "Context-aware privacy firewall for AI tools.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:4310/*",
        "http://localhost:4310/*"
      ],
      "js": [
        "page-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "http://127.0.0.1:4310/*",
        "http://localhost:4310/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VeilGuard AI"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
